{
	"name": "jalalix/php",
	"description": "Jalali (Persian / Shamsi) calendar for PHP. Pure PHP, no runtime dependencies.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"jalali",
		"persian",
		"shamsi",
		"calendar",
		"date",
		"iran"
	],
	"authors": [
		{
			"name": "Hossein Maklavani",
			"homepage": "https://maklavani.dev"
		}
	],
	"homepage": "https://jalalix.com",
	"support": {
		"source": "https://github.com/jalalix/php",
		"issues": "https://github.com/jalalix/php/issues"
	},
	"funding": [
		{
			"type": "open_collective",
			"url": "https://opencollective.com/jalalix"
		}
	],

	"require": {
		"php": ">=8.1",
		"ext-date": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5 || ^11.0"
	},
	"autoload": {
		"psr-4": {
			"Jalalix\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Jalalix\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
